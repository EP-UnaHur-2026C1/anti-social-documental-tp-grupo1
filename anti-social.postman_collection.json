{
  "info": {
    "name": "Anti Social Documental API",
    "description": "Coleccion de endpoints para la API de la red social Anti Social (UnaHur).\n\nRequiere variable:\n  {{base_url}} = http://localhost:3000",
    "schema": "https://raw.githubusercontent.com/postmanlabs/postman-collection/v2.1.0/schema/collection.json",
    "_exporter_id": "opencode-agent"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Usuarios",
      "description": "Operaciones CRUD sobre usuarios",
      "item": [
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickName\": \"juanperez\",\n  \"email\": \"juan@example.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/usuarios",
              "host": ["{{base_url}}"],
              "path": ["usuarios"]
            }
          }
        },
        {
          "name": "Obtener todos los usuarios",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/usuarios",
              "host": ["{{base_url}}"],
              "path": ["usuarios"]
            }
          }
        },
        {
          "name": "Obtener usuario por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/usuarios/6732a1b2c3d4e5f6a7b8c9d0",
              "host": ["{{base_url}}"],
              "path": ["usuarios", "6732a1b2c3d4e5f6a7b8c9d0"]
            }
          }
        },
        {
          "name": "Actualizar usuario",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickName\": \"juanperez_edit\",\n  \"email\": \"juan_nuevo@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/usuarios/6732a1b2c3d4e5f6a7b8c9d0",
              "host": ["{{base_url}}"],
              "path": ["usuarios", "6732a1b2c3d4e5f6a7b8c9d0"]
            }
          }
        },
        {
          "name": "Eliminar usuario (soft-delete)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/usuarios/6732a1b2c3d4e5f6a7b8c9d0",
              "host": ["{{base_url}}"],
              "path": ["usuarios", "6732a1b2c3d4e5f6a7b8c9d0"]
            }
          }
        },
        {
          "name": "Seguir usuario",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": \"6732b2c3d4e5f6a7b8c9d0e1\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/usuarios/6732a1b2c3d4e5f6a7b8c9d0/seguir",
              "host": ["{{base_url}}"],
              "path": ["usuarios", "6732a1b2c3d4e5f6a7b8c9d0", "seguir"]
            }
          }
        }
      ]
    },
    {
