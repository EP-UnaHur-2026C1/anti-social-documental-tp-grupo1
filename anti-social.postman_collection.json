            "body": {
              "mode": "raw",
              "raw": "{\n  \"texto\": \"Hello world! Este es mi primer post\",\n  \"idUsuario\": \"6732a1b2c3d4e5f6a7b8c9d0\",\n  \"tags\": [\"6732c3d4e5f6a7b8c9d0e1f2\"],\n  \"imagenes\": [\"https://ejemplo.com/imagen1.jpg\"]\n}"
