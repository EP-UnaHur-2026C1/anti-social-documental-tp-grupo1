# ============================================================
# Anti Social Documental API - Variables de Entorno
# ============================================================

# Puerto en el que correra el servidor Express
PORT=3000

# URI de conexion a MongoDB
# Ejemplo local: mongodb://localhost:27017/anti-social
# Ejemplo Docker: mongodb://mongodb:27017/anti-social
MONGO_URI=mongodb://localhost:27017/anti-social

# Cantidad de meses de antiguedad para ocultar comentarios
# Los comentarios mas antiguos que este valor se consideran "no visibles"
X_MESES=6